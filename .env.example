# @BotFather dan olingan token
BOT_TOKEN=123456:ABC-DEF...

# Bosh adminlarning Telegram ID raqamlari (vergul bilan). ID ni @userinfobot orqali bilish mumkin
SUPER_ADMIN_IDS=111111111

# Ma'lumotlar bazasi fayli
DB_PATH=data/bot.db

# --- Ixtiyoriy sozlamalar (standart qiymatlar ko'rsatilgan) ---
# Topshirmaganlarga eslatma oralig'i (soat) — muddatli va muddatsiz testlar uchun
REMINDER_INTERVAL_HOURS=1
# Muddat tugashidan necha daqiqa oldin oxirgi eslatma
FINAL_REMINDER_MINUTES=60
# Tungi tinch vaqt, Toshkent vaqti (bu oraliqda oddiy eslatma yuborilmaydi)
QUIET_HOURS=23-7
# Har bir to'g'ri javob uchun tanga
COINS_PER_CORRECT=1
# Testni topshirmaganlik uchun ayiriladigan tanga
PENALTY_NOT_SUBMITTED=5
# Jonli darsda qatnashgani uchun / qoldirgani uchun
COINS_PER_LESSON=10
PENALTY_MISSED_LESSON=0
# Haftalik reyting dushanba kuni soat nechada yuboriladi
WEEKLY_RATING_HOUR=9

# Kunlik vazifa: bajarmaganlardan "bajardingizmi?" deb so'rash oralig'i (daqiqa) va ertangi vazifalar boshlanish soati
TASK_REMINDER_MINUTES=60
TASK_DAY_START_HOUR=8

# --- Mini App ---
# Veb-server porti (hosting o'zi PORT bersa, o'shani ishlatadi)
PORT=8080
# Mini App'ning ochiq HTTPS manzili (masalan, hosting bergan domen). Bo'sh bo'lsa ilova tugmalari chiqmaydi
WEBAPP_URL=
