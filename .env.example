# @BotFather dan olingan token
BOT_TOKEN=123456:ABC-DEF...

# Bosh adminlarning Telegram ID raqamlari (vergul bilan). ID ni @userinfobot orqali bilish mumkin
SUPER_ADMIN_IDS=111111111

# Ma'lumotlar bazasi fayli
DB_PATH=data/bot.db

# --- Ixtiyoriy sozlamalar (standart qiymatlar ko'rsatilgan) ---
# Topshirmaganlarga eslatma oralig'i (soat)
REMINDER_INTERVAL_HOURS=3
# Muddat tugashidan necha daqiqa oldin oxirgi eslatma
FINAL_REMINDER_MINUTES=60
# Tungi tinch vaqt, Toshkent vaqti (bu oraliqda oddiy eslatma yuborilmaydi)
QUIET_HOURS=23-7
# Har bir to'g'ri javob uchun tanga
COINS_PER_CORRECT=1
# Testni topshirmaganlik uchun ayiriladigan tanga
PENALTY_NOT_SUBMITTED=5
# Haftalik reyting dushanba kuni soat nechada yuboriladi
WEEKLY_RATING_HOUR=9
